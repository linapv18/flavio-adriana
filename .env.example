# Disabled by default. Use only a NEW, isolated database for this client.
# The legacy DATABASE_URL variable is deliberately ignored.
WEDDING_DATABASE_ENABLED=false
WEDDING_DATABASE_URL=
# Generate a new, unique strong password; never reuse another client's password.
WEDDING_REPORT_PASSWORD=
# Optional: public address for guest links (e.g. a custom domain). On Vercel the production domain is used automatically.
WEDDING_SITE_URL=
